{
  "name": "@moysklad/sdk-tests-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Golden тесты сериализации/десериализации для TypeScript SDK",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:golden",
    "test:golden": "npm run build && node --test --test-reporter=tap build/golden/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
