"""Header response object."""

from __future__ import annotations
from typing import Mapping, Optional


class HeaderResponse:
    """
    Ответ вызова, полезные данные которого передаются в заголовках,
    а тело ответа отсутствует. Значения принадлежат конкретному вызову.
    """

    def __init__(self, status_code: int, headers: Mapping[str, str]) -> None:
        self._status_code = status_code
        self._headers = headers

    @property
    def status_code(self) -> int:
        return self._status_code

    @property
    def headers(self) -> Mapping[str, str]:
        return self._headers

    def get_header(self, name: str) -> Optional[str]:
        """
        Первое значение заголовка или None, если заголовка нет.
        Имя заголовка сравнивается без учета регистра.
        """
        for header_name, value in self._headers.items():
            if header_name.lower() == name.lower():
                return value
        return None

    @property
    def location(self) -> Optional[str]:
        """Значение заголовка Location или None, если заголовка нет."""
        return self.get_header("Location")
