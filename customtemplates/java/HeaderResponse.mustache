package {{invokerPackage}};

import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.TreeMap;

/**
 * Response of a call whose payload is carried by response headers and whose body is empty.
 * Values belong to a single call and are never shared between requests.
 */
public class HeaderResponse {
  private final int statusCode;
  private final Map<String, List<String>> headers;

  public HeaderResponse(int statusCode, Map<String, List<String>> headers) {
    Map<String, List<String>> caseInsensitive = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
    if (headers != null) {
      caseInsensitive.putAll(headers);
    }

    this.statusCode = statusCode;
    this.headers = Collections.unmodifiableMap(caseInsensitive);
  }

  public int getStatusCode() {
    return statusCode;
  }

  /**
   * Response headers, looked up without regard to case.
   *
   * @return response headers
   */
  public Map<String, List<String>> getHeaders() {
    return headers;
  }

  /**
   * First value of the header, looked up without regard to case; empty if the response did not carry it.
   *
   * @param name header name
   * @return header value
   */
  public Optional<String> getHeader(String name) {
    List<String> values = headers.get(name);
    if (values == null || values.isEmpty()) {
      return Optional.empty();
    }

    return Optional.ofNullable(values.get(0));
  }

  /**
   * Value of the Location header, empty if the response did not carry one.
   *
   * @return Location header value
   */
  public Optional<String> getLocation() {
    return getHeader("Location");
  }

  @Override
  public String toString() {
    return "HeaderResponse{statusCode=" + statusCode + ", location=" + getLocation().orElse(null) + "}";
  }
}
