namespace {{invokerPackage}};

/**
 * Ответ вызова, полезные данные которого передаются в заголовках,
 * а тело ответа отсутствует. Значения принадлежат конкретному вызову.
 *
 * @package {{invokerPackage}}
 */
class HeaderResponse
{
    /**
     * @param array<string, string[]> $headers
     */
    public function __construct(
        private readonly int $statusCode,
        private readonly array $headers,
    ) {
    }

    public function getStatusCode(): int
    {
        return $this->statusCode;
    }

    /**
     * @return array<string, string[]>
     */
    public function getHeaders(): array
    {
        return $this->headers;
    }

    /**
     * Первое значение заголовка или null, если заголовка нет.
     * Имя заголовка сравнивается без учета регистра.
     */
    public function getHeader(string $name): ?string
    {
        foreach ($this->headers as $headerName => $values) {
            if (strcasecmp($headerName, $name) === 0) {
                return $values[0] ?? null;
            }
        }

        return null;
    }

    /**
     * Значение заголовка Location или null, если заголовка нет.
     */
    public function getLocation(): ?string
    {
        return $this->getHeader('Location');
    }
}
